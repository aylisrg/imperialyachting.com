# Copy this file to .env.local (gitignored) and fill in real values for local
# development. Never commit actual secrets — only this template.

# ---------------------------------------------------------------------------
# Supabase (database, auth)
# ---------------------------------------------------------------------------
# Public project URL and anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key — bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe (payments)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Google Calendar (booking availability / sync)
# ---------------------------------------------------------------------------
# Base64-encoded service account JSON key. Falls back to
# GOOGLE_SERVICE_ACCOUNT_KEY (shared with Google Analytics below) when unset.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
# Base64-encoded service account JSON key, also used for Google Analytics.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------------------------
# Google Analytics (weekly analytics pipeline)
# ---------------------------------------------------------------------------
GOOGLE_ANALYTICS_PROPERTY_ID=

# ---------------------------------------------------------------------------
# Email (booking notifications, via Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
BOOKING_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Bookings / cron
# ---------------------------------------------------------------------------
# Shared secret required in the Authorization: Bearer header of scheduled
# booking-related cron requests (used by the GitHub Actions fallback
# workflow at .github/workflows/booking-cron.yml, and accepted by the
# cron routes for manual/local calls).
BOOKING_CRON_SECRET=
# Vercel's own Cron Jobs feature (see vercel.json) automatically sends
# `Authorization: Bearer ${CRON_SECRET}` to scheduled routes when this env
# var is set on the project — the booking cron routes accept it as an
# alternative to BOOKING_CRON_SECRET. NOTE: the Vercel Hobby plan only
# allows daily cron schedules (a deploy with a more frequent schedule is
# rejected), so vercel.json runs expire-holds once a day as a safety net.
# The real frequent trigger for expire-holds is the GitHub Actions workflow
# (every 15 min; requires SITE_URL + BOOKING_CRON_SECRET as repo secrets).
# On the Pro plan you may raise the vercel.json schedule to */10 * * * *.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Analytics pipeline (cron-triggered GA -> Claude -> Supabase -> Telegram)
# ---------------------------------------------------------------------------
ANALYTICS_CRON_SECRET=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# Key used to authenticate IndexNow submissions to search engines.
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) integration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MCP_URL=

# ---------------------------------------------------------------------------
# Instagram (social feed embed)
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# YouTube
# ---------------------------------------------------------------------------
YOUTUBE_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Admin document portal
# ---------------------------------------------------------------------------
DOCUMENTS_PASSWORD=
DOCUMENTS_SESSION_SECRET=
